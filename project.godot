; Engine configuration file.
; Godot 4.7 — 타임론 (Time Loan) 프로토타입

config_version=5

[application]

config/name="타임론 (Time Loan)"
config/description="시간을 빌려 쓰고 미래에서 갚는 시간 예산 퍼즐"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

TimeDirector="*res://scripts/time_director.gd"
InputQueue="*res://scripts/input_queue.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60
2d/run_on_separate_thread=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
# Android 익스포트 필수: ETC2/ASTC VRAM 압축 임포트 활성화
textures/vram_compression/import_etc2_astc=true

[input]

; 입력은 InputMap 대신 코드에서 직접 키로 읽는다 (프로토타입 단순화)
; Shift = Borrow(대출), R = Repay(상환), Q = 예약 입력 배치
